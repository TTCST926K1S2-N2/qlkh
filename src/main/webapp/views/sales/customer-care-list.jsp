<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>S3-09 - Chăm sóc khách hàng định kỳ</title>
<style>
*{box-sizing:border-box}body{font:14px Arial,sans-serif;background:#f3f6fb;color:#182b49;margin:0}.wrap{max-width:1200px;margin:32px auto;padding:0 20px}.panel{background:white;border:1px solid #dce5f0;border-radius:12px;padding:24px;box-shadow:0 4px 20px #2030500a}h1{margin:0 0 10px;font-size:26px}p{color:#63758c}.tools{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:24px 0}label{display:flex;flex-direction:column;gap:8px;font-weight:600}input{border:1px solid #cdd8e6;border-radius:6px;padding:10px;width:130px}button,.back{border:0;border-radius:6px;background:#2563eb;color:#fff;padding:10px 15px;cursor:pointer;text-decoration:none}button:disabled{opacity:.5;cursor:wait}.back{background:#eef3fa;color:#17427e;display:inline-block;margin-bottom:20px}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:760px}th,td{padding:14px 12px;border-bottom:1px solid #e5edf5;text-align:left}th{background:#f3f6fb}#notice{min-height:20px;color:#b42318}#notice.ok{color:#067647}.empty{text-align:center;color:#64748b}
</style></head><body><main class="wrap"><a class="back" href="${pageContext.request.contextPath}/views/sales/customers.jsp">Quay lại quản lý khách hàng</a>
<section class="panel"><h1>Danh sách khách hàng cần chăm sóc</h1><p>Khách hàng chưa có tương tác trong N ngày. Sắp xếp theo giá trị hợp đồng giảm dần.</p>
<div class="tools"><label>Số ngày chưa liên hệ<input id="days" type="number" min="1" max="3650" value="30"></label><button id="load" type="button">Lọc danh sách</button></div>
<div id="notice" role="status"></div><div class="scroll"><table><thead><tr><th>Mã</th><th>Khách hàng</th><th>Trạng thái</th><th>Giá trị hợp đồng</th><th>Liên hệ gần nhất</th><th>Số ngày chưa liên hệ</th><th>Thao tác</th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Đang tải...</td></tr></tbody></table></div></section></main>
<script>
(()=>{'use strict';const root='${pageContext.request.contextPath}',rows=document.getElementById('rows'),notice=document.getElementById('notice'),load=document.getElementById('load'),days=document.getElementById('days');
const money=new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND',maximumFractionDigits:0});
function message(s,ok=false){notice.textContent=s;notice.className=ok?'ok':''}
async function request(url,opts){const r=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json'},...opts});if(r.status===401){location.href=root+'/login';throw Error('Phiên đăng nhập đã hết hạn')}const d=await r.json().catch(()=>null);if(!r.ok)throw Error(d?.error||'Yêu cầu thất bại');return d}
function cell(tr,s){const td=document.createElement('td');td.textContent=String(s??'');tr.appendChild(td);return td}
async function refresh(){const n=Number(days.value);if(!Number.isInteger(n)||n<1||n>3650){message('Nhập N từ 1 đến 3650');return}load.disabled=true;message('');rows.replaceChildren();try{const data=await request(root+'/api/v1/customer-care-list?days='+n);if(!Array.isArray(data)||!data.length){const tr=rows.insertRow();const td=cell(tr,'Không có khách hàng cần chăm sóc');td.colSpan=7;td.className='empty';return}for(const c of data){const tr=rows.insertRow();cell(tr,c.id);cell(tr,c.companyName);cell(tr,c.status);cell(tr,money.format(Number(c.contractValue||0)));cell(tr,c.lastContactAt?new Date(c.lastContactAt).toLocaleString('vi-VN'):'Chưa liên hệ');cell(tr,c.daysSinceContact);const td=cell(tr,'');const b=document.createElement('button');b.type='button';b.textContent='Đã liên hệ';b.addEventListener('click',async()=>{if(!confirm('Xác nhận đã liên hệ với '+c.companyName+'?'))return;b.disabled=true;try{await request(root+'/api/v1/customer-care-list/'+c.id+'/contact',{method:'POST'});message('Đã ghi nhận liên hệ với '+c.companyName,true);await refresh()}catch(e){message(e.message);b.disabled=false}});td.appendChild(b)}}catch(e){message(e.message)}finally{load.disabled=false}}
load.addEventListener('click',refresh);refresh();})();
</script></body></html>
